{
    "name": "gtaol",
    "version": "0.1",
    "type": "module",
    "description": "GTAOL Helper",
    "main": "./package-server/serve.js",
    "license": "UNLICENSED",
    "browser": {
        "dependency": false
    },
    "scripts": {
        "clean": "rm -rf node_modules && rm -rf package-lock.json",
