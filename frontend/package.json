        "@react-router/dev": "^8.3.0",
        "@types/node": "^26.1.1",
        "@vitejs/plugin-react": "^6.0.4",
        "dotenv": "^17.4.2",
        "isbot": "^5",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.1",
        "typescript": "^5.9.3",
        "vite": "^8.1.5",
        "vite-tsconfig-paths": "^6.1.1"
    },
    "devDependencies": {
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3"
    }
